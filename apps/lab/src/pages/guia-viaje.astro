    </div>
    <div class="ciudad-meta"><span class="cd">10–15 sep · Galicia</span><h3>El Camino y Santiago</h3></div>
    <input class="tab-input tab-ver" type="radio" name="tabs-camino" id="camino-ver" checked>
    <input class="tab-input tab-local" type="radio" name="tabs-camino" id="camino-local">
