    <div class="ciudad-media">
      <img src="/viaje/photos/toledo.jpg" alt="Vista de Toledo sobre el río Tajo" loading="lazy" decoding="async">
    </div>
    <div class="ciudad-meta"><span class="cd">Martes 8 sep · España</span><h3>Toledo</h3></div>
    <input class="tab-input tab-ver" type="radio" name="tabs-toledo" id="toledo-ver" checked>
    <input class="tab-input tab-local" type="radio" name="tabs-toledo" id="toledo-local">
