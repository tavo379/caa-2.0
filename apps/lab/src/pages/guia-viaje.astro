    <div class="ciudad-meta"><span class="cd">21–23 sep · Italia</span><h3>Milán y el Lago de Como</h3></div>
    <input class="tab-input tab-ver" type="radio" name="tabs-como" id="como-ver" checked>
    <input class="tab-input tab-local" type="radio" name="tabs-como" id="como-local">
