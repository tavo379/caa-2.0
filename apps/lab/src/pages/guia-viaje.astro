    <div class="ciudad-meta"><span class="cd">23–25 sep · Italia</span><h3>Florencia</h3></div>
    <input class="tab-input tab-ver" type="radio" name="tabs-florencia" id="florencia-ver" checked>
    <input class="tab-input tab-local" type="radio" name="tabs-florencia" id="florencia-local">
    <input class="tab-input tab-mesa" type="radio" name="tabs-florencia" id="florencia-mesa">
    <input class="tab-input tab-calle" type="radio" name="tabs-florencia" id="florencia-calle">
