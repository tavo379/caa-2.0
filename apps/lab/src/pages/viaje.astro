<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tracker de compras · Europa 6–30 sep 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{
  --azul:#1D4E89;--azul-osc:#10304F;--amarillo:#F0B429;--papel:#F7F4EC;--negro:#1f2528;
  --tinta:#22303C;--verde:#3E6B4F;--rojo:#B4432D;--gris:#6B7580;--blanco:#fff;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Space Grotesk',system-ui,sans-serif;background:var(--papel);color:var(--tinta);line-height:1.5;font-size:15px;overflow-x:hidden}
.wrap{max-width:820px;margin:0 auto;padding:0 14px}

/* ===== HERO / MASTHEAD ===== */
header{background:var(--azul-osc);color:#fff;padding:44px 0 40px}
.eyebrow{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--amarillo);margin-bottom:8px}
h1{font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;font-size:clamp(30px,7vw,44px);line-height:1}

/* ===== LAYOUT — sidebar (panel + filtros) junto a la lista en desktop ===== */
main.wrap{padding:36px 14px 60px;display:block}
.side{margin-bottom:18px}
@media (min-width:900px){
  main.wrap{max-width:1040px;display:grid;grid-template-columns:296px 1fr;gap:26px;align-items:start}
  .side{position:sticky;top:20px;margin-bottom:0}
}

/* PANEL PRESUPUESTO — el ancla visual */
.panel{background:var(--azul-osc);color:#fff;border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:18px}
.panel-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px;gap:10px;flex-wrap:wrap}
.gastado{font-family:'IBM Plex Mono',monospace;font-size:24px;font-weight:600;color:var(--amarillo)}
.gastado small{font-size:12.5px;color:#9FB3C8;font-weight:400}
.restante{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:#C9D6E4;text-align:right}
.restante b{display:block;font-size:17px;color:#fff;font-weight:500}
.barra{height:26px;background:rgba(0,0,0,.28);border-radius:7px;overflow:hidden;position:relative;border:1px solid rgba(255,255,255,.1)}
.fill{height:100%;background:repeating-linear-gradient(115deg,var(--amarillo) 0 13px,#D99C1F 13px 26px);width:0;transition:width .45s cubic-bezier(.4,0,.2,1);min-width:0}
.barra span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:600;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.6);letter-spacing:.03em}
.meta{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;margin-top:14px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#9FB3C8}
.meta b{color:#fff;font-weight:500;display:block;font-size:13px}

/* FILTROS — la acción principal, con más presencia */
.filtros{margin-top:14px;display:grid;grid-template-columns:1fr 1fr;gap:7px}
.fbtn{background:var(--blanco);border:1.5px solid #D8D2C4;color:var(--tinta);font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;padding:12px 10px;border-radius:11px;cursor:pointer;line-height:1.25;text-align:left;transition:transform .12s,border-color .12s,background .12s,color .12s}
.fbtn .fcount{display:block;font-family:'IBM Plex Mono',monospace;font-size:10.5px;font-weight:500;opacity:.65;margin-top:2px}
.fbtn:hover{border-color:var(--azul);transform:translateY(-1px)}
.fbtn:focus-visible{outline:2px solid var(--amarillo);outline-offset:2px}
.fbtn[data-p="0"]{grid-column:1/-1}
.fbtn[data-p="0"].on{background:var(--azul);border-color:var(--azul);color:#fff}
.fbtn[data-p="1"].on{background:var(--rojo);border-color:var(--rojo);color:#fff}
.fbtn[data-p="2"].on{background:#D99C1F;border-color:#D99C1F;color:#fff}
.fbtn[data-p="3"].on{background:var(--verde);border-color:var(--verde);color:#fff}
.fbtn.on .fcount{opacity:.85}

/* NOTAS */
.nota{position:relative;background:#FDF6E3;border-radius:12px;padding:11px 13px 11px 24px;margin:0 0 14px;font-size:13.5px}
.nota::before{content:"";position:absolute;left:11px;top:16px;width:7px;height:7px;border-radius:50%;background:var(--amarillo)}
.nota b{color:#8a6410}
.gratis{background:#E9F2EA}
.gratis::before{background:var(--verde)}
.gratis b{color:var(--verde)}

/* SEPARADOR DE FECHA */
.fecha{display:flex;align-items:center;gap:11px;margin:18px 0 8px}
.fecha span{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--azul);background:var(--papel);padding-right:4px;white-space:nowrap}
.fecha::after{content:"";flex:1;height:2px;background:repeating-linear-gradient(to right,var(--amarillo) 0 7px,transparent 7px 14px)}
.fecha:first-child{margin-top:0}

/* ETIQUETA DE PRIORIDAD */
.prio{display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 7px;border-radius:4px;margin-bottom:4px}
.p1{background:#FBE3DD;color:var(--rojo)}
.p2{background:#FCEBC9;color:#8a6410}
.p3{background:#DEEAE2;color:var(--verde)}
.g-sub{font-size:13.5px;color:var(--gris)}

/* ITEM — denso, con lo pendiente dominando */
.item{background:var(--blanco);border:1px solid #E4DFD2;border-radius:10px;padding:8px 12px;margin-bottom:6px;display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;transition:opacity .18s,background .18s,padding .18s}
.item.listo{background:#F1F4EF;border-color:#CFDCC9;opacity:.55;padding:5px 12px}
.item.listo:hover,.item.listo:focus-within{opacity:1}
.item.listo .donde,.item.listo .cuando,.item.listo .prio,.item.listo .est{display:none}
.item.listo .nombre{text-decoration:line-through;text-decoration-color:var(--verde);text-decoration-thickness:1.5px;font-size:12.5px;font-weight:500}
.box{width:34px;height:34px;border:2px solid var(--azul);border-radius:8px;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0;color:transparent;font-size:15px;font-weight:700;transition:.15s}
.box:hover{background:#EDF3FA}
.box:focus-visible{outline:2px solid var(--amarillo);outline-offset:2px}
.item.listo .box{background:var(--verde);border-color:var(--verde);color:#fff;width:26px;height:26px}
.info .nombre{font-weight:600;font-size:14px;color:var(--azul-osc);line-height:1.3}
.info .donde{font-size:12px;color:var(--gris);margin-top:2px}
.info .donde b{color:var(--azul);font-weight:600}
.cuando{display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;background:#EDF0F5;color:var(--azul);padding:1px 6px;border-radius:4px;margin-top:4px;letter-spacing:.02em}
.precio{text-align:right;flex-shrink:0;display:flex;align-items:center;gap:8px}
.est{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--gris);white-space:nowrap}
.real{width:74px;padding:5px 7px;border:1.5px solid #D8D2C4;border-radius:7px;font-family:'IBM Plex Mono',monospace;font-size:12.5px;text-align:right;background:var(--papel);color:var(--tinta)}
.real:focus{outline:none;border-color:var(--amarillo);background:#fff}
.item.listo .real{border-color:var(--verde);background:#fff;font-weight:600;color:var(--verde);width:64px}

footer{border-top:1px solid #E0DACB;padding:32px 0 40px;text-align:center;margin-top:16px}
.acciones{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.reset{background:none;border:1px solid #D8D2C4;color:var(--gris);font-family:'IBM Plex Mono',monospace;font-size:11.5px;padding:7px 15px;border-radius:8px;cursor:pointer}
.reset:hover{border-color:var(--rojo);color:var(--rojo)}
#estado{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--gris);margin-top:10px;min-height:15px}

@media (max-width:560px){
  .item{grid-template-columns:30px 1fr}
  .precio{grid-column:2;text-align:left;display:flex;align-items:center;gap:9px;margin-top:5px}
  .gastado{font-size:20px}
  .meta{grid-template-columns:1fr 1fr}
}
@media (prefers-reduced-motion:reduce){.fill{transition:none}.item,.fbtn{transition:none}}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="eyebrow">Lista de compras · Camino &amp; Europa</div>
    <h1>Qué falta comprar</h1>
  </div>
</header>

<main class="wrap">
  <aside class="side">
    <div class="panel">
      <div class="panel-top">
        <div class="gastado"><span id="gastado">0 €</span> <small>registrados</small></div>
        <div class="restante">Queda del presupuesto<b id="restante">7.550 €</b></div>
      </div>
      <div class="barra"><div class="fill" id="fill"></div><span id="barraTxt">0% del presupuesto</span></div>
      <div class="meta">
        <span><b id="hechos">0</b> de <b id="total">0</b> comprado</span>
        <span><b id="urgentes">0</b> urgentes sin comprar</span>
        <span>Faltan <b id="dias">—</b> días para el vuelo</span>
        <span>Presupuesto: <b>7.550 €</b> · 2 personas</span>
      </div>
    </div>
    <div class="filtros">
      <button class="fbtn on" data-p="0">Todo<span class="fcount"></span></button>
      <button class="fbtn" data-p="1">Compra ya<span class="fcount"></span></button>
      <button class="fbtn" data-p="2">Antes de sept<span class="fcount"></span></button>
      <button class="fbtn" data-p="3">Sin afán<span class="fcount"></span></button>
    </div>
  </aside>

  <div class="lista-col">
    <div class="nota"><b>Cómo se usa:</b> marca la casilla cuando compres y escribe lo que pagaste (en euros, los dos juntos). Se guarda solo. Está en orden cronológico de uso, con la prioridad de compra en cada línea.</div>
    <div id="lista"></div>
    <div class="nota gratis"><b>Dos cosas que NO hay que comprar:</b> el Vaticano es gratis el domingo 27 (llegar 7:30 am, no se reserva online) y el Prado es gratis el lunes 7 de 18:00 a 20:00, justo cuando aterrizan. Ahorro: ~84 €.</div>
  </div>
</main>

<footer>
  <div class="acciones">
    <button class="reset" id="exportar">Descargar respaldo</button>
    <label class="reset" for="importar" style="cursor:pointer">Importar respaldo</label>
    <input type="file" id="importar" accept="application/json" hidden>
    <button class="reset" id="reset">Borrar todo</button>
  </div>
  <div id="estado"></div>
</footer>

<script is:inline>
const PRESUPUESTO = 7550;
const CLAVE = 'tracker-viaje-europa-2026';

const ITEMS = [
 // --- ANTES DE VIAJAR (sin fecha de uso) ---
 {id:'zapa', f:'', o:0, p:1, n:'Zapatillas de trail o botas — COMPRAR ACÁ', d:'Aunque en Europa cuesten la mitad: hay que amansarlas caminando en Medellín. Es lo único que no se compra allá', e:0},
 {id:'seguro', f:'', o:1, p:1, n:'Seguro de viaje para los dos', d:'Cobertura médica ≥ 60.000 € · 25 días', e:260},
 {id:'esim', f:'', o:2, p:2, n:'eSIM de datos ×2', d:'Holafly / Airalo — activar antes de salir', e:60},
 {id:'botiquin', f:'', o:3, p:2, n:'Botiquín: Compeed, vaselina, ibuprofeno', d:'Líquidos en frascos ≤ 100 ml', e:0},
 {id:'mochila', f:'', o:4, p:2, n:'Mochila de cabina ×2 + morral plegable 15 L ×2', d:'El morral va vacío dentro de la grande', e:0},
 {id:'adapta', f:'', o:5, p:3, n:'Adaptador tipo C/F ×2, power bank, candado', d:'El candado es para las taquillas del hostel', e:0},

 // --- SEPTIEMBRE ---
 {id:'hMad1', f:'Lun 7 sep', o:7, p:2, n:'Alojamiento Madrid — 2 noches', d:'Huertas / Barrio de las Letras o La Latina', e:130},
 {id:'toledo', f:'Mar 8 sep', o:8, p:2, n:'Bus Alsa Madrid ↔ Toledo', d:'Sale de Plaza Elíptica, directo de 50 min. Ida 8:30, regreso 20:30 o 21:00', e:50},
 {id:'ropa', f:'Mié 9 sep', o:9, p:3, n:'Ropa técnica en Decathlon Madrid', d:'Camisetas y medias merino, bóxers, impermeable ≥5.000 mm, pantalón. <b>Allá cuesta la mitad</b> — ir en la mañana, el tren sale 18:06', e:200},
 {id:'vue1', f:'Mié 9 sep', o:9, p:1, n:'Tren Madrid Chamartín → Sarria 17:10 → 21:02', d:'AVE + Media Distancia, enlace de 13 min en Ourense', e:60},
 {id:'cam0', f:'Mié 9 sep', o:9, p:1, n:'Pensión en Sarria', d:'Booking — zona Rúa Maior, cerca de la estación (llegan 22:13)', e:50},
 {id:'baston', f:'Mié 9 sep', o:9, p:3, n:'Bastones + credencial — en Sarria', d:'Los bastones no pasan en cabina. Se compran allá y se donan en Santiago', e:45},
 {id:'paq', f:'Jue 10 sep', o:10, p:2, n:'Paq Mochila — las 5 etapas', d:'elcaminoconcorreos.com', e:70},
 {id:'cam1', f:'Jue 10 sep', o:10, p:1, n:'Albergue privado Portomarín', d:'Booking — privado, ~18-20 €/persona', e:40},
 {id:'cam2', f:'Vie 11 sep', o:11, p:1, n:'Albergue privado Palas de Rei', d:'Booking', e:40},
 {id:'cam3', f:'Sáb 12 sep', o:12, p:1, n:'Albergue privado Arzúa', d:'Booking', e:40},
 {id:'cam4', f:'Dom 13 sep', o:13, p:1, n:'Albergue privado O Pedrouzo', d:'Booking', e:40},
 {id:'hSan', f:'Lun 14 sep', o:14, p:2, n:'Alojamiento Santiago', d:'Casco viejo — la noche de la Compostela', e:75},
 {id:'vue2', f:'Mar 15 sep', o:15, p:1, n:'Vuelo Vueling Santiago → Burdeos 11:25', d:'Vía Barcelona, llega 17:45', e:100},
 {id:'hBur', f:'Mar 15 sep', o:15, p:2, n:'Alojamiento Burdeos — 3 noches', d:'MEININGER Gare Saint-Jean, 15 al 18', e:229},
 {id:'arc', f:'Jue 17 sep', o:17, p:3, n:'Trenes Burdeos ↔ Arcachon', d:'En la estación, regional — no hay que comprarlo antes', e:72},
 {id:'vue3', f:'Vie 18 sep', o:18, p:1, n:'Ouigo Burdeos → París ~17 h', d:'ouigo.com — desde 16 €, tope 59 €', e:60},
 {id:'hPar', f:'Vie 18 sep', o:18, p:2, n:'Alojamiento París — 3 noches', d:'Distritos 10-11 · con cocina', e:285},
 {id:'eLou', f:'Sáb 19 sep', o:19, p:2, n:'Louvre', d:'ticketlouvre.fr — primera hora', e:44},
 {id:'vue4', f:'Lun 21 sep', o:21, p:1, n:'Vuelo easyJet París CDG → Milán Linate 17:25', d:'easyjet.com, directo, 1h30', e:212},
 {id:'hMil', f:'Lun 21 sep', o:21, p:2, n:'Alojamiento Milán — 2 noches', d:'Brera o zona Duomo', e:160},
 {id:'como', f:'Mar 22 sep', o:22, p:3, n:'Trenes Milán ↔ Varenna (Lago de Como)', d:'Regional directo desde Milano Centrale, 1h03. Se compra el mismo día', e:36},
 {id:'tren1', f:'Mié 23 sep', o:23, p:1, n:'Frecciarossa Milán → Florencia 6:10', d:'Llega 8:04. Comprar en trenitalia.com, tarifa Super Economy', e:80},
 {id:'hFlo', f:'Mié 23 sep', o:23, p:2, n:'Alojamiento Florencia — 2 noches', d:'Hostel 7 Santi, noches del 23 y 24', e:255},
 {id:'eCup', f:'Mié 23 sep', o:23, p:2, n:'Cúpula de Brunelleschi', d:'duomo.firenze.it — se agota semanas antes', e:60},
 {id:'eUff', f:'Jue 24 sep', o:24, p:2, n:'Uffizi o Galleria dell\'Accademia', d:'b-ticket.com — elegir uno solo', e:50},
 {id:'valdorcia1', f:'Vie 25 sep', o:25, p:2, n:'Alojamiento Val d\'Orcia — 1 noche', d:'Montepulciano, Pienza o San Quirico', e:90},
 {id:'valdorcia2', f:'Vie 25 sep', o:25, p:2, n:'Transporte a la Toscana', d:'Bus Florencia–Siena–Val d\'Orcia o carro 2 días', e:120},
 {id:'trenChiusi', f:'Sáb 26 sep', o:26, p:3, n:'Tren Chiusi-Chianciano → Roma Termini', d:'La estación que sirve al Val d\'Orcia. ~2h. Se compra sobre la fecha, no se agota', e:40},
 {id:'hRom', f:'Sáb 26 sep', o:26, p:2, n:'Alojamiento Roma — 3 noches', d:'Monti o Trastevere, noches del 26, 27 y 28', e:240},
 {id:'eCol', f:'Lun 28 sep', o:28, p:2, n:'Coliseo + Foro + Palatino', d:'coopculture.it — franja de las 8:30', e:36},
 {id:'vueRoma', f:'Mar 29 sep', o:29, p:1, n:'Vuelo Roma → Madrid (noche)', d:'Tiquete aparte del AV17', e:200},
 {id:'hMad2', f:'Mar 29 sep', o:29, p:2, n:'Alojamiento Madrid final', d:'Centro o Barajas — llegan ~23:30', e:70}
];

const PRIOS = {
 1:{t:'Compra ya', c:'p1', d:'Se agota o sube de precio'},
 2:{t:'Antes de sept', c:'p2', d:'Con cancelación gratis'},
 3:{t:'Sin afán', c:'p3', d:'O se compra allá'}
};

let datos = {};
let filtro = 0; // 0 = todo, 1/2/3 = prioridad
const $ = id => document.getElementById(id);

function render(){
  const cont = $('lista'); cont.innerHTML = '';
  const vis = ITEMS.filter(i => !filtro || i.p === filtro);
  if (!vis.length){ cont.innerHTML = '<p class="g-sub">Nada en este filtro.</p>'; totales(); return; }
  let fechaActual = null;
  vis.forEach(i => {
    const etiqueta = i.f || 'Antes de viajar';
    if (etiqueta !== fechaActual){
      fechaActual = etiqueta;
      const h = document.createElement('div');
      h.className = 'fecha';
      h.innerHTML = `<span>${etiqueta}</span>`;
      cont.appendChild(h);
    }
    const d = datos[i.id] || {};
    const pr = PRIOS[i.p];
    const el = document.createElement('div');
    el.className = 'item' + (d.ok ? ' listo' : '');
    el.innerHTML = `
      <button class="box" data-id="${i.id}" aria-pressed="${!!d.ok}" aria-label="Marcar ${i.n} como comprado">✓</button>
      <div class="info">
        <span class="prio ${pr.c}">${pr.t}</span>
        <div class="nombre">${i.n}</div>
        ${i.d ? `<div class="donde">${i.d}</div>` : ''}
      </div>
      <div class="precio">
        ${i.e ? `<div class="est">est. ${i.e} €</div>` : '<div class="est">—</div>'}
        <input class="real" type="number" min="0" step="1" placeholder="€" data-id="${i.id}" value="${d.p ?? ''}" aria-label="Precio pagado">
      </div>`;
    cont.appendChild(el);
  });
  totales();
}

function totales(){
  const hechos = ITEMS.filter(i => datos[i.id]?.ok).length;
  const gastado = ITEMS.reduce((s,i) => s + (Number(datos[i.id]?.p) || 0), 0);
  const pct = Math.min(100, (gastado / PRESUPUESTO) * 100);
  const fmt = n => Math.round(n).toLocaleString('es-CO') + ' €';
  $('gastado').textContent = fmt(gastado);
  $('restante').textContent = fmt(PRESUPUESTO - gastado);
  $('hechos').textContent = hechos;
  $('total').textContent = ITEMS.length;
  $('fill').style.width = pct + '%';
  $('barraTxt').textContent = pct < 1 ? '0% del presupuesto' : pct.toFixed(1) + '% del presupuesto';
  const pend1 = ITEMS.filter(i => i.p === 1 && !datos[i.id]?.ok).length;
  $('urgentes').textContent = pend1;
  const salida = new Date(2026, 8, 6);
  const dias = Math.ceil((salida - new Date()) / 864e5);
  $('dias').textContent = dias > 0 ? dias : '¡ya!';
}

// --- Adaptador: Supabase (sincroniza entre dispositivos) con localStorage como caché/respaldo offline ---
const SUPABASE_URL = 'https://kvvfuidlvsjaqommeaie.supabase.co';
const SUPABASE_KEY = 'sb_publishable_WX-UmxeRqy7dpcGgwa4Sgw_33VwR1C6';
const SB_HEADERS = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };

const store = {
  async get(k){
    try {
      const r = await fetch(SUPABASE_URL + '/rest/v1/lab_kv?key=eq.' + encodeURIComponent(k) + '&select=data', { headers: SB_HEADERS });
      if (!r.ok) throw new Error('http ' + r.status);
      const rows = await r.json();
      if (rows[0]) { localStorage.setItem(k, JSON.stringify(rows[0].data)); return rows[0].data; }
      return null;
    } catch(e){
      try { const local = localStorage.getItem(k); return local ? JSON.parse(local) : null; }
      catch(e2){ return null; }
    }
  },
  async set(k, v){
    try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){}
    const r = await fetch(SUPABASE_URL + '/rest/v1/lab_kv', {
      method: 'POST',
      headers: Object.assign({}, SB_HEADERS, { 'Content-Type': 'application/json', Prefer: 'resolution=merge-duplicates' }),
      body: JSON.stringify([{ key: k, data: v, updated_at: new Date().toISOString() }])
    });
    if (!r.ok) throw new Error('http ' + r.status);
  },
  async del(k){
    localStorage.removeItem(k);
    await fetch(SUPABASE_URL + '/rest/v1/lab_kv?key=eq.' + encodeURIComponent(k), { method: 'DELETE', headers: SB_HEADERS });
  }
};

async function guardar(){
  try {
    await store.set(CLAVE, datos);
    $('estado').textContent = 'Guardado ' + new Date().toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'});
  } catch(e){
    $('estado').textContent = 'Sin conexión: guardado solo en este dispositivo.';
  }
}

async function cargar(){
  try {
    const remote = await store.get(CLAVE);
    if (remote) datos = remote;
  } catch(e){ datos = {}; }
  render();
}

function exportar(){
  const blob = new Blob([JSON.stringify(datos, null, 2)], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'tracker-viaje-' + new Date().toISOString().slice(0,10) + '.json';
  a.click();
  URL.revokeObjectURL(a.href);
}

function importar(ev){
  const f = ev.target.files[0];
  if (!f) return;
  const fr = new FileReader();
  fr.onload = () => {
    try {
      const d = JSON.parse(fr.result);
      if (typeof d !== 'object' || d === null) throw new Error('formato');
      datos = d; render(); guardar();
      $('estado').textContent = 'Respaldo importado.';
    } catch(e){ $('estado').textContent = 'Ese archivo no sirve.'; }
  };
  fr.readAsText(f);
  ev.target.value = '';
}

document.addEventListener('click', e => {
  const f = e.target.closest('.fbtn');
  if (f){
    filtro = Number(f.dataset.p);
    document.querySelectorAll('.fbtn').forEach(b => b.classList.toggle('on', b === f));
    render();
    return;
  }
  const b = e.target.closest('.box');
  if (!b) return;
  const id = b.dataset.id;
  datos[id] = datos[id] || {};
  datos[id].ok = !datos[id].ok;
  render(); guardar();
});

document.addEventListener('input', e => {
  if (!e.target.classList.contains('real')) return;
  const id = e.target.dataset.id;
  datos[id] = datos[id] || {};
  const v = e.target.value;
  datos[id].p = v === '' ? null : Number(v);
  totales();
});
document.addEventListener('change', e => {
  if (e.target.classList.contains('real')) guardar();
});

$('reset').addEventListener('click', async () => {
  if (!confirm('¿Borrar todas las marcas y precios? No se puede deshacer.')) return;
  datos = {};
  render();
  try { await store.del(CLAVE); $('estado').textContent = 'Todo borrado.'; }
  catch(e){ $('estado').textContent = 'Se borró en pantalla, pero no en memoria.'; }
});

$('exportar').addEventListener('click', exportar);
$('importar').addEventListener('change', importar);

cargar();
</script>

<script is:inline>
// Aditivo, puramente visual: cuenta estática de ítems por prioridad en los botones de filtro.
// No lee ni modifica `datos`, no toca render()/totales() ni el estado guardado.
(function(){
  var counts = { 0:0, 1:0, 2:0, 3:0 };
  ITEMS.forEach(function(i){ counts[0]++; counts[i.p] = (counts[i.p]||0) + 1; });
  document.querySelectorAll('.fbtn[data-p]').forEach(function(btn){
    var p = btn.getAttribute('data-p');
    var span = btn.querySelector('.fcount');
    if (span) span.textContent = counts[p] + ' ítems';
  });
})();
</script>

</body>
</html>
