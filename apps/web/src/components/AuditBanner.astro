---
import { ArrowRight } from "lucide-astro";

interface Props {
    label: string;
    title: string;
    description: string;
    ctaText: string;
    href: string;
}

const { label, title, description, ctaText, href } = Astro.props;
---

<section class="ds-section ds-section--border-b audit-banner-section">
    <div class="ds-container">
        <div class="audit-banner">
            <div class="audit-banner__text">
                <span class="ds-label">{label}</span>
                <h2 class="ds-h3 audit-banner__title">{title}</h2>
                <p class="ds-body audit-banner__desc">{description}</p>
            </div>
            <a href={href} class="ds-btn ds-btn--outline">
                {ctaText}
                <span class="ds-btn__dot">
                    <ArrowRight size={12} strokeWidth={2} />
                </span>
            </a>
        </div>
    </div>
</section>

<style>
    .audit-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-8);
        padding: var(--space-8);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: var(--radius-md);
        background-color: var(--surface);
    }

    .audit-banner__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 640px;
    }

    .audit-banner__title {
        margin: 0;
    }

    .audit-banner__desc {
        margin: 0;
        color: var(--fg-muted);
    }

    .audit-banner .ds-btn {
        flex-shrink: 0;
    }

    @media (max-width: 768px) {
        .audit-banner {
            flex-direction: column;
            align-items: flex-start;
            padding: var(--space-6);
        }
    }
</style>
